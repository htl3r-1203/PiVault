# Kopiere diese Datei nach .env und ersetze die Platzhalter durch eigene, sichere Passwörter.
# Die .env wird nicht in Git eingecheckt.

# Öffentlicher Port von Apache auf dem Host
WEB_PORT=8080

# Erlaubte Origins für CORS (nur nötig, wenn das Frontend nicht über Apache läuft)
CORS_ORIGINS=http://localhost:8080

# MariaDB
MARIADB_DATABASE=pivault
MARIADB_USER=pivault
MARIADB_PASSWORD=BITTE_AENDERN
MARIADB_ROOT_PASSWORD=BITTE_AENDERN
