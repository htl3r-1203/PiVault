# ==============================================================================
# PiVault – Umgebungsvariablen (Vorlage)
# ==============================================================================
# Kopiere diese Datei nach .env und ersetze die Platzhalter durch sichere Werte.
# Die Datei .env darf NIEMALS in die Versionskontrolle eingecheckt werden!
# ==============================================================================

# Webserver-Ports auf dem Host
WEB_PORT=8080
WEB_SSL_PORT=8443

# Host- und CORS-Absicherung
# Erlaubte Host-Header (Schutz vor Host-Header-Injection)
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend,pivault
# Erlaubte Origins für CORS (nur nötig bei separatem Frontend-Devserver)
CORS_ORIGINS=http://localhost:8080

# API-Dokumentation (/api/docs, /api/redoc, /api/openapi.json in Produktion deaktiviert)
DOCS_ENABLED=false

# Session- und Cookie-Sicherheit
# Für HTTPS zwingend COOKIE_SECURE=true setzen! Bei unverschlüsseltem HTTP false.
COOKIE_SECURE=false
SESSION_LIFETIME_MINUTES=480
SESSION_IDLE_TIMEOUT_MINUTES=30

# Rate-Limiting & Brute-Force-Schutz
RATE_LIMIT_ENABLED=true

# MariaDB Datenbankzugangsdaten
MARIADB_DATABASE=pivault
MARIADB_USER=pivault
MARIADB_PASSWORD=BITTE_AENDERN
MARIADB_ROOT_PASSWORD=BITTE_AENDERN

# Optional: Pfad zu dateibasierten Secrets (z. B. Docker Secrets / Run-Secrets)
# DB_PASSWORD_FILE=/run/secrets/db_password
